<mvc:View
    controllerName="com.co.stratesys.zpscopiarproyectos.controller.Master"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
>
    <f:DynamicPage
        id="masterPage"
        headerExpanded="false"
    >
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title
                        id="tituloProyectos"
                        text="Proyectos(0)"
                    />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
            <List
                id="proyectosList"
                items="{
                    path: '/QueryProy'
                }"
                mode="MultiSelect"
                growing="true"
                growingScrollToLoad="true"
                noDataText="{i18n>masterNoData}"
                selectionChange="onSelectionChange"
                updateFinished="onListUpdateFinished"
                busyIndicatorDelay="0"
            >
                <headerToolbar>
                    <Toolbar height="auto">
                        <VBox width="100%">
                            <HBox
                                class="sapUiTinyMarginBottom"
                                alignItems="Center"
                            >
                                <Button
                                    id="copyButton"
                                    icon="sap-icon://copy"
                                    press="onCopy"
                                    text="Copiar Proyectos"
                                    class="sapUiTinyMarginEnd"
                                />
                                <Button
                                    id="selectAllButton"
                                    icon="sap-icon://complete"
                                    tooltip="Marcar Todo"
                                    press="onSelectAll"
                                    class="sapUiTinyMarginEnd"
                                />
                                <Button
                                    id="deselectAllButton"
                                    icon="sap-icon://decline"
                                    tooltip="Desmarcar Todo"
                                    press="onDeselectAll"
                                />
                                <ToggleButton
                                    id="btnSoloSeleccionados"
                                    icon="sap-icon://multiselect-all"
                                    pressed="false"
                                    tooltip="Solo Seleccionados"
                                    press="onToggleSoloSeleccionados"
                                />
                            </HBox>

                            <MultiInput
                                width="100%"
                                liveChange="onSearch"
                                class="sapUiTinyMarginBottom"
                                placeholder="Buscar por ID o nombre de proyecto"
                                showValueHelp="true"
                                valueHelpRequest="valueHelpProyectos"
                            />

                            <HBox
                                class="sapUiTinyMarginTop"
                                wrap="Wrap"
                                alignItems="Center"
                            >
                                <VBox width="16rem">
                                    <Label
                                        text="Estado de Procesamiento"
                                        labelFor="estadoProcesamientoFilter"
                                        class="sapUiTinyMarginBottom"
                                    />
                                    <MultiComboBox
                                        id="estadoProcesamientoFilter"
                                        width="100%"
                                        selectionChange="onEstadoProcesamientoChange"
                                        placeholder="Todos"
                                    >
                                        <core:Item
                                            key="Planificado"
                                            text="Planificado"
                                        />
                                        <core:Item
                                            key="Preparacion"
                                            text="Preparación"
                                        />
                                        <core:Item
                                            key="Ejecucion"
                                            text="En Ejecución"
                                        />
                                        <core:Item
                                            key="Completado"
                                            text="Completado"
                                        />
                                    </MultiComboBox>
                                </VBox>
                            </HBox>
                        </VBox>
                    </Toolbar>
                </headerToolbar>
                <items>
                    <ObjectListItem
                        type="Active"
                        press="onPress"
                        title="{ProjectName}"
                        number="{ProjectID}"
                    >
                        <attributes>
                            <ObjectAttribute
                                title="{i18n>estado}"
                                text="{StageDesc}"
                            />
                        </attributes>
                        <attributes>
                            <ObjectAttribute
                                title="{i18n>Cliente}"
                                text="{Customer}"
                            />
                        </attributes>
                        <attributes>
                            <ObjectAttribute text="{CustomerName}" />
                        </attributes>
                    </ObjectListItem>
                </items>
            </List>
        </f:content>
    </f:DynamicPage>
</mvc:View>
